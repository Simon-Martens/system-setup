# DankMaterialShell (DMS) Integration for Hyprland
# Include this file in hyprland.conf to enable DMS features
# Comment out or remove the source line to disable DMS

######################## DankShell Key Bindings
# Application Launchers
# bind = SUPER, V, exec, dms ipc call clipboard toggle
# bind = SUPER, Y, exec, dms ipc call dankdash wallpaper
bind = SUPER, Space, exec, dms ipc call widget toggle launcherButton
bind = CTRL ALT, DELETE, exec, dms ipc call processlist focusOrToggle
bind = SUPER, Comma, exec, dms ipc call settings focusOrToggle
bind = SUPER, N, exec, dms ipc call notifications toggle
bind = SUPER SHIFT, N, exec, dms ipc call notepad toggle
bind = SUPER SHIFT, C, exec, dms ipc call powermenu toggle
bind = SUPER SHIFT, L, exec, dms ipc call lock lock

# Screenshots via DankShell
bind = , Print, exec, dms ipc call screenshot capture
bind = CTRL, Print, exec, dms ipc call screenshot captureScreen
bind = ALT, Print, exec, dms ipc call screenshot captureWindow

######################## Media Keys (via DankShell)
# Audio controls
bindel = ,XF86AudioRaiseVolume, exec, pamixer --allow-boost --increase 3
bindel = ,XF86AudioLowerVolume, exec, pamixer --allow-boost --decrease 3
bindel = ,XF86AudioMute, exec, dms ipc call audio mute
bindel = ,XF86AudioMicMute, exec, dms ipc call audio micmute

# Brightness controls
bindel = ,XF86MonBrightnessUp, exec, dms ipc call brightness increment 5 ""
bindel = ,XF86MonBrightnessDown, exec, dms ipc call brightness decrement 5 ""

# Media player controls
bindl = ,XF86AudioNext, exec, dms ipc call mpris next
bindl = ,XF86AudioPause, exec, dms ipc call mpris playPause
bindl = ,XF86AudioPlay, exec, dms ipc call mpris playPause
bindl = ,XF86AudioPrev, exec, dms ipc call mpris previous

######################## DankShell Window Rules
windowrule {
    name = dms-quickshell
    match:class = org.quickshell
    float = true
}

source = ./dms/outputs.conf
source = ./dms/colors.conf
source = ./dms/layout.conf
source = ./dms/cursor.conf
