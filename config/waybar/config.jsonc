{
	"reload_style_on_change": true,
  "layer": "top",
  "position": "top",
	"mode": "dock",
	"start_hidden": false,
  "modules-left": [
		"custom/notification",
		"hyprland/workspaces",
		"hyprland/window"
	],
	"modules-center": [
		"clock#day", 
		"custom/polycat", 
		"clock#time"
	],
  "modules-right": [
    "group/tray-expander",
		"battery",
		"backlight",
    "pulseaudio",
    "network",
		"bluetooth"
  ],
	"backlight": {
    "tooltip": false,
		"device": "intel_backlight",
		"format": "{icon}  {percent}",
		"format-icons": ["󰃜", "󰃛", "󰃚", "󰃞", "󰃟", "󰃠" ]
	},
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "active": "",
      "default": ""
    },
		"on-scroll-up": "hyprctl dispatch workspace r-1",
		"on-scroll-down": "hyprctl dispatch workspace r+1"
  },
	"hyprland/window": {
		"format": "{title}",
		"rewrite": {
				"": "Desktop",
        "(.*) — Mozilla Firefox": "  $1",
				"(.*nvim.*)": "  $1",
				"(.*bash.*)": "󰆍  $1",
				"(.*air.*)": "  $1",
				"(.*~.*)": "󰅬  $1"
		},
    "tooltip": false,
		"separate-outputs": true,
		"on-click": "~/.local/share/system-setup/bin/system-setup-launcher -t --windows",
		"on-scroll-up": "hyprctl dispatch workspace r-1",
		"on-scroll-down": "hyprctl dispatch workspace r+1"
	},
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
    	"tray"
    ]
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false
  },
  "tray": {
		"show-passive-items": true,
    "icon-size": 12,
    "spacing": 12,
		"icons": {
			"Ghostty": "utilities-terminal-symbolic",
			"ghostty": "utilities-terminal-symbolic",
			"Alacritty": "utilities-terminal-symbolic",
			"chrome-outlook.office.com__mail_-Default": "microsoft-outlook",
			"chrome-teams.microsoft.com__-Default": "microsoft-teams",
			"chrome-web.whatsapp.com__-Default": "whatsapp",
			"chrome-music.youtube.com__-Default": "youtube-music",
			"chrome-translate.google.com__-Default": "google-translate",
			"chrome-chatgpt.com__-Default": "chatgpt",
			"chrome-gemini.google.com__-Default": "google-gemini",
			"chrome-claude.ai__-Default": "claude-ai",
			"chrome-chat.deepseek.com__-Default": "deepseek",
			"chrome-web.telegram.org__-Default": "telegram"
		}
  },
 "custom/niflveil": {
        "format": "{}",
        "exec": "~/.local/share/system-setup/bin/niflveil show",
        "on-click": "~/.local/share/system-setup/bin/niflveil restore",
        "return-type": "json",
        "interval": "once",
        "signal": 8
  },
  "custom/music": {
    "format": "  {}",
    "escape": true,
    "interval": 20,
    "tooltip": false,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "playerctl play-pause",
    "max-length": 50
  },
  "clock#day": {
		"interval": 60,
    "timezone": "Europe/Berlin",
		"tooltip-format": "{:%d.%m.%Y | %H:%M:%S}",
    //"format": "{:%d.%m. %H:%M}"
		"format": "{:%A}",
  },
  "clock#time": {
		"interval": 60,
    "timezone": "Europe/Berlin",
		"tooltip-format": "{:%d.%m.%Y | %H:%M:%S}",
    //"format": "{:%d.%m. %H:%M}"
		"format": "{:%H:%M}",
  },
	  "battery": {
    "format": "{capacity} {icon}",
    "format-discharging": "{icon}  {capacity}|{power:0.2f}",
    "format-charging":    "{icon}",
		"format-full":     "",
    "format-icons": {
      "charging": [
        "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"
      ],
      "default": [
        "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
      ]
    },
    "tooltip-format-discharging": "{power:>1.0f}W↓\n{capacity}%\n{time}",
    "tooltip-format-charging": "{power:>1.0f}W↑\n{capacity}%\n{time}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
		"on-click": "~/.local/share/system-setup/bin/system-setup-launcher -t --governor"
  },
  "network": {
    "format-wifi": "󰤢  {essid}",
		"tooltip": true,
		"tooltip-format-wifi": "{signaldBm} dBm\n{frequency} GHz\n{ipaddr}\n{gwaddr}",
    "format-ethernet": "󰈀  {ipaddr}",
		"tooltip-format-ethernet": "{ifname}\n{bandwidthDownBits}\n{bandwidthUpBits}\n{gwaddr}",
    "format-disconnected": "󰤠  No Network",
    "interval": 10,
		"on-click": "ghostty --class=nmtui -e bash -c \"sleep 0.5; nmtui\""
  },
  "cpu": {
    "interval": 5,
    "format": "{usage:>2}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
		"on-click": "ghostty --class=btop -e btop"
  },
  "memory": {
    "interval": 30,
    "format": "{used:0.1f}",
		"on-click": "ghostty --class=btop -e btop"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}",
    "format-muted": " ",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "ghostty --class=wiremix -e bash -c \"sleep 0.2; wiremix -v output\"",
		"on-scroll-up": "wpctl set-volume -l 2.0 @DEFAULT_AUDIO_SINK@ 2%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },
	"bluetooth": {
		"format": "·",
		"format-disabled": "󰂲",
		"format-connected": " {device_alias}",
		"tooltip-format": "Devices connected:\n {device_enumerate}",
		"on-click": "ghostty --class=bluetui -e bash -c \"sleep 0.5; bluetui\""
	},
	"custom/tmux": {
		"exec": "bash -c 'list=$(tmux ls 2>/dev/null | tr \"\\n\" \"\\r\"); lo=$(tmux ls 2>/dev/null); [ -n \"$lo\" ] && count=$(echo \"$lo\" | wc -l | grep -x \"[1-9][0-9]*\") && echo \"$count\" && echo \"$list\"'",
		"exec-if": "bash -c type tmux",
		"hide-empty-text": true,
		"return-type": "text",
		"interval": 20,
		"tooltip": true,
		"format": "  {text}",
		"on-click": "~/.local/share/system-setup/bin/system-setup-launcher -t --tmux"
	},
  "custom/lock": {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0.5s; hyprlock --immediate)' & disown",
    "format": ""
  },
  "custom/polycat": {
		"exec": "bash -c ~/.local/share/system-setup/bin/polycat || echo ''",
		"return-type": "text",
		"tooltip": false,
		"on-click": "ghostty --class=btop -e btop"
	},
	"keyboard-state": {
			"numlock": true,
			"capslock": true,
			"format": "{name} {icon}",
			"format-icons": {
					"locked": "",
					"unlocked": ""
			}
	},
	"custom/weather": {
		"exec": "bash -c '/home/simon/.local/share/system-setup/bin/weather'",
		"return-type": "json",
		"tooltip": true,
		"format": "{}",
		"on-click": "gnome-weather",
		"interval": 600
	},
"power-profiles-daemon": {
  "format": "{icon}",
  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
  "tooltip": true,
  "format-icons": {
    "default": "",
    "performance": "",
    "balanced": "",
    "power-saver": ""
  }
},
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
