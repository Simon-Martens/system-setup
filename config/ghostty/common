# General
mouse-hide-while-typing = true
cursor-style-blink = true
cursor-style = "bar"
clipboard-read = allow
clipboard-write = allow
confirm-close-surface = false
theme = "Ardoise"
copy-on-select = true
window-padding-x = 5
window-padding-y = 4
window-decoration = none

gtk-wide-tabs = false
gtk-custom-css = "./style.css"
# background-opacity = 0.98

# Font settings
font-family = "GeistMono Nerd Font"
font-family-italic = "MonaspiceRn Nerd Font"
font-size = 13.0
# font-feature = -calt, -liga, -dlig # Disables programming font ligatures as they look ugly af
# adjust-cell-height = 1%
# adjust-cell-width = 3%

# Keybindings
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+a>f=toggle_fullscreen
keybind = ctrl+shift+n=new_window
keybind = ctrl+a>n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+a>c=new_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+a>w=close_tab


keybind = "ctrl+shift+1=goto_tab:1"
keybind = "ctrl+a>1=goto_tab:1"
keybind = "ctrl+shift+2=goto_tab:2"
keybind = "ctrl+a>2=goto_tab:2"
keybind = "ctrl+shift+3=goto_tab:3"
keybind = "ctrl+a>3=goto_tab:3"
keybind = "ctrl+shift+4=goto_tab:4"
keybind = "ctrl+a>4=goto_tab:4"
keybind = "ctrl+shift+5=goto_tab:5"
keybind = "ctrl+a>5=goto_tab:5"
keybind = "ctrl+shift+6=goto_tab:6"
keybind = "ctrl+a>6=goto_tab:6"
keybind = "ctrl+shift+7=goto_tab:7"
keybind = "ctrl+a>7=goto_tab:7"
keybind = "ctrl+shift+8=goto_tab:8"
keybind = "ctrl+a>8=goto_tab:8"
keybind = "ctrl+shift+9=goto_tab:9"
keybind = "ctrl+a>9=goto_tab:9"

keybind = ctrl+shift+v=new_split:right
keybind = ctrl+a>v=new_split:right
keybind = ctrl+shift+b=new_split:down
keybind = ctrl+a>b=new_split:down

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+a>l=goto_split:right

