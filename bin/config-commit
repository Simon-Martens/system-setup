#!/bin/bash

set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") <commit-message>" >&2
    exit 1
}

if [ "$#" -eq 0 ]; then
    usage
fi

REPO_DIR="$HOME/.local/share/system-setup"

if [ ! -d "$REPO_DIR/.git" ]; then
    echo "Error: Repository not found at $REPO_DIR" >&2
    exit 2
fi

COMMIT_MESSAGE="$*"

pushd "$REPO_DIR" >/dev/null

git add -A

if git diff --cached --quiet; then
    echo "Nothing to commit."
    popd >/dev/null
    exit 0
fi

git commit -m "$COMMIT_MESSAGE"

popd >/dev/null
