#!/bin/bash

# Fast FZF-based application launcher with caching
# Builds cache in background, uses existing cache for immediate startup

CACHE_DIR="$HOME/.cache/tlauncher"
CACHE_FILE="$CACHE_DIR/apps.cache"
MODES_CACHE_FILE="$CACHE_DIR/modes.cache"
LOCK_FILE="$CACHE_DIR/rebuild.lock"
MODES_DIR="$HOME/.local/share/system-setup/bin/modes"

mkdir -p "$CACHE_DIR"

# Global arrays to store mode information and hierarchy
declare -A MODES_INFO
declare -a MODES_ORDER
declare -A MODE_CHILDREN  # Maps parent mode to array of child modes
declare -A MODE_PARENT    # Maps child mode to parent mode

# Save mode information to cache
save_modes_cache() {
    local cache_file="$1"
    {
        # Save MODES_INFO array
        for key in "${!MODES_INFO[@]}"; do
            printf "MODES_INFO[%q]=%q\n" "$key" "${MODES_INFO[$key]}"
        done
        
        # Save MODES_ORDER array
        printf "MODES_ORDER=("
        for item in "${MODES_ORDER[@]}"; do
            printf "%q " "$item"
        done
        printf ")\n"
        
        # Save MODE_CHILDREN array
        for key in "${!MODE_CHILDREN[@]}"; do
            printf "MODE_CHILDREN[%q]=%q\n" "$key" "${MODE_CHILDREN[$key]}"
        done
        
        # Save MODE_PARENT array
        for key in "${!MODE_PARENT[@]}"; do
            printf "MODE_PARENT[%q]=%q\n" "$key" "${MODE_PARENT[$key]}"
        done
    } > "$cache_file"
}

# Load mode information from cache
load_modes_from_cache() {
    local cache_file="$1"
    [[ -f "$cache_file" ]] || return 1
    
    # Clear existing arrays
    MODES_INFO=()
    MODES_ORDER=()
    MODE_CHILDREN=()
    MODE_PARENT=()
    
    # Source the cache file to restore arrays
    source "$cache_file"
}

# Check if modes cache is stale
modes_cache_is_stale() {
    [[ ! -f "$MODES_CACHE_FILE" ]] && return 0
    [[ ! -d "$MODES_DIR" ]] && return 1
    
    # Check if any mode script is newer than cache
    for mode_script in "$MODES_DIR"/*.sh; do
        [[ -f "$mode_script" && "$mode_script" -nt "$MODES_CACHE_FILE" ]] && return 0
    done
    
    return 1
}

# Load mode information from mode scripts
load_modes() {
    MODES_INFO=()
    MODES_ORDER=()
    MODE_CHILDREN=()
    MODE_PARENT=()
    
    [[ ! -d "$MODES_DIR" ]] && return
    
    for mode_script in "$MODES_DIR"/*.sh; do
        [[ ! -f "$mode_script" ]] && continue
        
        # Source the mode script and get its info
        if source "$mode_script" 2>/dev/null && declare -f get_mode_info >/dev/null 2>&1; then
            local mode_info
            mode_info=$(get_mode_info)
            [[ -z "$mode_info" ]] && continue
            
            local prefix icon name cmdline_switch
            read -r prefix icon name cmdline_switch <<< "$mode_info"
            
            MODES_INFO["$prefix"]="$icon $name $cmdline_switch $(basename "$mode_script")"
            MODES_ORDER+=("$prefix")
        fi
    done
    
    # Sort modes by prefix length (longest first) for proper matching
    readarray -t MODES_ORDER < <(printf '%s\n' "${MODES_ORDER[@]}" | sort -r)
    
    # Build mode hierarchy based on common prefixes
    build_mode_hierarchy
    
    # Save to cache
    save_modes_cache "$MODES_CACHE_FILE"
}

# Build hierarchical relationships between modes based on prefixes
build_mode_hierarchy() {
    # Pre-sort by length for more efficient processing
    local -a sorted_prefixes
    readarray -t sorted_prefixes < <(printf '%s\n' "${MODES_ORDER[@]}" | awk '{print length($0) " " $0}' | sort -n | cut -d' ' -f2-)
    
    # Build parent-child relationships efficiently
    local i j
    for ((i=0; i<${#sorted_prefixes[@]}; i++)); do
        local child_prefix="${sorted_prefixes[i]}"
        local best_parent=""
        local best_parent_len=0
        
        # Find the longest matching parent (most immediate)
        for ((j=0; j<i; j++)); do
            local parent_prefix="${sorted_prefixes[j]}"
            
            # Check if child starts with parent and parent is longer than current best
            if [[ "$child_prefix" == "$parent_prefix"* ]] && [[ ${#parent_prefix} -gt $best_parent_len ]]; then
                best_parent="$parent_prefix"
                best_parent_len=${#parent_prefix}
            fi
        done
        
        # Record the relationship if we found a parent
        if [[ -n "$best_parent" ]]; then
            MODE_PARENT["$child_prefix"]="$best_parent"
            
            # Add to parent's children list
            if [[ -n "${MODE_CHILDREN[$best_parent]}" ]]; then
                MODE_CHILDREN["$best_parent"]="${MODE_CHILDREN[$best_parent]} $child_prefix"
            else
                MODE_CHILDREN["$best_parent"]="$child_prefix"
            fi
        fi
    done
}

# Get parent mode of a given mode
get_parent_mode() {
    local mode="$1"
    echo "${MODE_PARENT[$mode]}"
}

# Get children modes of a given mode
get_child_modes() {
    local mode="$1"
    echo "${MODE_CHILDREN[$mode]}"
}

# Check if a mode is a parent mode (has children)
is_parent_mode() {
    local mode="$1"
    [[ -n "${MODE_CHILDREN[$mode]}" ]]
}

# Check if a mode is a child mode (has a parent)
is_child_mode() {
    local mode="$1"
    [[ -n "${MODE_PARENT[$mode]}" ]]
}

# Find matching mode for a query
find_mode_for_query() {
    local query="$1"
    
    # Special case: "/ /" should match "//" (workspace mode)
    if [[ "$query" == "/ /"* ]]; then
        echo "//"
        return 0
    fi
    
    # Try spaced pattern matching (e.g., ": power" should match ":power")
    # This needs to come before direct matching to handle spaced variants correctly
    for prefix in "${MODES_ORDER[@]}"; do
        # Check if this prefix can have spaced variants
        if [[ "$prefix" =~ ^: ]] && [[ "$prefix" != ":" ]]; then
            if [[ "$query" == ": ${prefix#:}"* ]]; then
                echo "$prefix"
                return 0
            fi
        fi
    done
    
    # Then try direct prefix matching
    for prefix in "${MODES_ORDER[@]}"; do
        if [[ "$query" == "$prefix"* ]]; then
            echo "$prefix"
            return 0
        fi
    done
    
    return 1
}

# Get mode script path from prefix
get_mode_script() {
    local prefix="$1"
    local mode_info="${MODES_INFO[$prefix]}"
    [[ -z "$mode_info" ]] && return 1
    
    local script_name
    script_name=$(echo "$mode_info" | awk '{print $NF}')
    echo "$MODES_DIR/$script_name"
}

# Load data for a specific mode
load_mode_data() {
    local prefix="$1"
    local query="$2"
    local mode_script
    
    mode_script=$(get_mode_script "$prefix")
    [[ ! -f "$mode_script" ]] && return 1
    
    if source "$mode_script" 2>/dev/null && declare -f load_data >/dev/null 2>&1; then
        load_data "$query"
    fi
}

# Handle selection for a specific mode
handle_mode_selection() {
    local prefix="$1"
    local selected="$2"
    local mode_script
    
    mode_script=$(get_mode_script "$prefix")
    [[ ! -f "$mode_script" ]] && return 1
    
    if source "$mode_script" 2>/dev/null && declare -f handle_selection >/dev/null 2>&1; then
        handle_selection "$selected"
        return $?
    fi
    
    return 1
}

# Initialize modes - use cache if available and fresh
if load_modes_from_cache "$MODES_CACHE_FILE" && ! modes_cache_is_stale; then
    # Cache loaded successfully and is fresh
    :
else
    # Cache missing or stale, load from scratch
    load_modes
fi

process_desktop_file() {
    local desktop_file="$1"
    local name generic_name comment hidden nodisplay
    
    # Quick type check
    grep -q "^Type=Application" "$desktop_file" || return
    
    # Check Hidden and NoDisplay fields
    hidden=$(grep "^Hidden=" "$desktop_file" 2>/dev/null | cut -d'=' -f2)
    nodisplay=$(grep "^NoDisplay=" "$desktop_file" 2>/dev/null | cut -d'=' -f2)
    
    [[ "$hidden" == "true" || "$nodisplay" == "true" ]] && return
    
    # Extract name fields
    name=$(grep "^Name=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    generic_name=$(grep "^GenericName=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    comment=$(grep "^Comment=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    keywords=$(grep "^Keywords=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    
    # Build display string: prefer generic name, show short comment if no generic name
    display_name="$name"
    if [[ -n "$generic_name" && "$generic_name" != "$name" ]]; then
        # Use generic name if available
        display_name="$name"$'\033[90m'" · $generic_name"$'\033[0m'
    elif [[ -n "$comment" && ${#comment} -le 30 ]]; then
        # Use short comment (30 chars or less) if no generic name
        display_name="$name"$'\033[90m'" · $comment"$'\033[0m'
    fi
    
    # Build search text (includes keywords but they won't be displayed)
    search_text="$name"
    [[ -n "$generic_name" ]] && search_text="$search_text $generic_name"
    [[ -n "$comment" ]] && search_text="$search_text $comment"
    [[ -n "$keywords" ]] && search_text="$search_text $keywords"
    
    basename=$(basename "$desktop_file" .desktop)
    echo "$display_name"$'\t'"$search_text"$'\t'"$basename"
}

rebuild_cache() {
    # Build search directories
    declare -a search_dirs=()
    [[ -n "$XDG_DATA_HOME" ]] && search_dirs+=("$XDG_DATA_HOME/applications")
    [[ -z "$XDG_DATA_HOME" ]] && search_dirs+=("$HOME/.local/share/applications")

    if [[ -n "$XDG_DATA_DIRS" ]]; then
        IFS=':' read -ra dirs <<< "$XDG_DATA_DIRS"
        for dir in "${dirs[@]}"; do
            search_dirs+=("$dir/applications")
        done
    else
        search_dirs+=("/usr/local/share/applications" "/usr/share/applications")
    fi

    # Process desktop files
    declare -A seen_apps
    for dir in "${search_dirs[@]}"; do
        [[ -d "$dir" ]] || continue
        find "$dir" -maxdepth 1 -name "*.desktop" 2>/dev/null
    done | while read desktop_file; do
        basename=$(basename "$desktop_file" .desktop)
        [[ -n "${seen_apps[$basename]}" ]] && continue
        seen_apps[$basename]=1
        process_desktop_file "$desktop_file"
    done | sort > "$CACHE_FILE.tmp" && mv "$CACHE_FILE.tmp" "$CACHE_FILE"
}


cache_is_stale() {
    [[ ! -f "$CACHE_FILE" ]] && return 0
    
    # Check if any desktop directory is newer than cache
    declare -a search_dirs=()
    [[ -n "$XDG_DATA_HOME" ]] && search_dirs+=("$XDG_DATA_HOME/applications")
    [[ -z "$XDG_DATA_HOME" ]] && search_dirs+=("$HOME/.local/share/applications")
    
    if [[ -n "$XDG_DATA_DIRS" ]]; then
        IFS=':' read -ra dirs <<< "$XDG_DATA_DIRS"
        for dir in "${dirs[@]}"; do
            search_dirs+=("$dir/applications")
        done
    else
        search_dirs+=("/usr/local/share/applications" "/usr/share/applications")
    fi
    
    for dir in "${search_dirs[@]}"; do
        [[ -d "$dir" && "$dir" -nt "$CACHE_FILE" ]] && return 0
    done
    
    return 1
}


# Cached command availability checks
COMMANDS_CACHE_FILE="$CACHE_DIR/commands.cache"

# Cache command availability
cache_command_availability() {
    {
        echo "HAS_HYPRCTL=$(command -v hyprctl >/dev/null 2>&1 && echo 1 || echo 0)"
        echo "HAS_TMUX=$(command -v tmux >/dev/null 2>&1 && echo 1 || echo 0)"
        echo "HAS_JQ=$(command -v jq >/dev/null 2>&1 && echo 1 || echo 0)"
        echo "HAS_NOTIFY_SEND=$(command -v notify-send >/dev/null 2>&1 && echo 1 || echo 0)"
    } > "$COMMANDS_CACHE_FILE"
}

# Load cached command availability or create cache
if [[ ! -f "$COMMANDS_CACHE_FILE" ]] || [[ "$COMMANDS_CACHE_FILE" -ot "$0" ]]; then
    cache_command_availability
fi
source "$COMMANDS_CACHE_FILE"

# Helper functions to check if commands are available
has_hyprctl() {
    [[ "$HAS_HYPRCTL" == "1" ]]
}

has_tmux() {
    [[ "$HAS_TMUX" == "1" ]]
}

has_jq() {
    [[ "$HAS_JQ" == "1" ]]
}

has_notify_send() {
    [[ "$HAS_NOTIFY_SEND" == "1" ]]
}

# Utility function to launch applications - uses setsid for detached launching
launch_app() {
    local command="$1"
    setsid bash -c "$command" >/dev/null 2>&1 &
}

# Utility function for Hyprland-specific launching - handles arbitrary command strings
launch_app_hyprland() {
    local command="$*"  # Use $* to get all arguments as a single string
    if has_hyprctl; then
        eval "hyprctl dispatch exec $command"
    else
        # Fallback to regular launch for non-Hyprland environments
        eval "$command" >/dev/null 2>&1 &
    fi
}

# Utility function to run command in current terminal and start shell
launch_in_current_terminal() {
    local command="$1"
    
    if has_hyprctl; then
        # Get current window info to check what needs to be reverted
        if has_jq; then
            local window_info=$(hyprctl activewindow -j)
            local is_floating=$(echo "$window_info" | jq -r '.floating')
            local is_pinned=$(echo "$window_info" | jq -r '.pinned') 
            local window_addr=$(echo "$window_info" | jq -r '.address')
        else
            local window_addr=$(hyprctl activewindow | grep -oP 'Address: \K.*')
            local is_floating="false"
            local is_pinned="false"
        fi
        
        # Revert launcher window rules to normal window behavior using dispatchers
        # Make it tiled if currently floating
        if [[ "$is_floating" == "true" ]]; then
            hyprctl dispatch togglefloating
        fi
        
        # Unpin if currently pinned
        if [[ "$is_pinned" == "true" ]]; then
            hyprctl dispatch pin
        fi
        
        # Use setprop for properties that support it
        hyprctl dispatch setprop address:$window_addr dimaround 0     # Remove background dimming
        hyprctl dispatch setprop address:$window_addr bordersize 2    # Normal border size
        
        # Note: stayfocused cannot be easily reverted as it's not a toggleable property
    fi
    
    # Clear the terminal and run the command
    clear
    echo "════════════════════════════════════════"
    echo "🚀 Launching: $command"
    echo "════════════════════════════════════════"
    echo
    
    # Execute the command
    eval "$command"
}

# Utility function to run command in current terminal WITHOUT changing window properties
run_in_current_terminal() {
    local command="$1"
    
    if has_hyprctl; then
        # Resize window to be larger for terminal applications and center it
        if has_jq; then
            local window_addr=$(hyprctl activewindow -j | jq -r '.address')
        else
            local window_addr=$(hyprctl activewindow | grep -oP 'Address: \K.*')
        fi
        hyprctl dispatch resizewindowpixel exact 1200 800,address:$window_addr
        hyprctl dispatch centerwindow
    fi
    
    # Clear the terminal and run the command (keeping all window properties as-is)
    clear
    echo "════════════════════════════════════════"
    echo "🚀 Executing: $command"
    echo "════════════════════════════════════════"
    echo
    
    # Execute the command
    eval "$command"
    
    # No need to wait for user input - just return to launcher automatically
}


# Check if we're being called as a reload script
if [[ "$1" == "--reload" ]]; then
    CACHE_FILE="$2"
    QUERY="$3"
    
    # Initialize modes for reload context (lazy load - only if needed)
    if [[ -z "${MODES_INFO:-}" ]]; then
        if load_modes_from_cache "$MODES_CACHE_FILE" && ! modes_cache_is_stale; then
            :
        else
            load_modes
        fi
    fi
    
    # Try to find a matching mode for the query
    matching_prefix=$(find_mode_for_query "$QUERY")
    
    if [[ -n "$matching_prefix" ]]; then
        # Load data for the matching mode
        load_mode_data "$matching_prefix" "$QUERY"
    else
        # Default to application cache
        cat "$CACHE_FILE"
    fi
    exit 0
fi

# Check for existing launcher instance and handle accordingly
check_existing_launcher() {
    # Skip check if we're inside a terminal launcher (recursive call)
    if [[ -n "$TLAUNCHER_PREVIOUS_WINDOW_FILE" ]]; then
        return 1
    fi
    
    # Check if there's already a launcher window active (more reliable than process check)
    if has_hyprctl; then
        if has_jq; then
            local launcher_window=$(hyprctl clients -j | jq -r '.[] | select(.class == "launcher") | .address' | head -1)
            local current_workspace=$(hyprctl activeworkspace -j | jq -r '.id')
        else
            local launcher_window=$(hyprctl clients | grep -A10 "class: launcher" | grep -oP 'Address: \K.*' | head -1)
            local current_workspace=$(hyprctl activeworkspace | grep -oP 'workspace ID \K\d+')
        fi
        
        if [[ -n "$launcher_window" ]]; then
            # Move to current workspace and focus
            hyprctl dispatch movetoworkspacesilent "${current_workspace},address:$launcher_window"
            hyprctl dispatch focuswindow "address:$launcher_window"
            
            # Show notification
            if has_notify_send; then
                notify-send "Launcher" "Launcher is already active" --urgency=low --expire-time=2000
            fi
            
            return 0
        fi
    fi
    
    return 1
}

# Parse command line arguments
START_MODE=""
INITIAL_QUERY=""
TERMINAL_MODE=false

# Generate usage message from available modes
generate_usage() {
    echo "Usage: $0 [--update] [-t|--terminal] $(printf '[%s] ' $(for prefix in "${MODES_ORDER[@]}"; do echo "${MODES_INFO[$prefix]}" | awk '{print $3}'; done))"
    echo "  --update     Update application cache"
    echo "  -t, --terminal    Open launcher in external terminal window"
    
    for prefix in "${MODES_ORDER[@]}"; do
        mode_info="${MODES_INFO[$prefix]}"
        icon=$(echo "$mode_info" | awk '{print $1}')
        name=$(echo "$mode_info" | awk '{print $2}')
        cmdline_switch=$(echo "$mode_info" | awk '{print $3}')
        printf "  %-12s Start in %s mode\n" "$cmdline_switch" "$name"
    done
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --update)
            echo "Updating cache..."
            rebuild_cache
            echo "Cache updated successfully"
            exit 0
            ;;
        -t|--terminal)
            TERMINAL_MODE=true
            shift
            ;;
        *)
            # Check if argument matches any mode's command line switch
            mode_found=false
            for prefix in "${MODES_ORDER[@]}"; do
                mode_info="${MODES_INFO[$prefix]}"
                cmdline_switch=$(echo "$mode_info" | awk '{print $3}')
                
                if [[ "$1" == "$cmdline_switch" ]]; then
                    START_MODE="$prefix"
                    INITIAL_QUERY="$prefix "
                    mode_found=true
                    break
                fi
            done
            
            if [[ "$mode_found" == false ]]; then
                generate_usage
                exit 1
            fi
            
            shift
            ;;
    esac
done

# Handle terminal mode by launching in external terminal
if [[ "$TERMINAL_MODE" == true ]]; then
    # Check for existing launcher instance BEFORE creating new terminal
    if check_existing_launcher; then
        exit 0
    fi
    # Capture the currently active window in background while launching terminal
    if has_hyprctl; then
        # Start window capture in background and launch terminal immediately
        {
            if has_jq; then
                TLAUNCHER_PREVIOUS_WINDOW=$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty')
            else
                TLAUNCHER_PREVIOUS_WINDOW=$(hyprctl activewindow 2>/dev/null | grep -oP 'Address: \K.*' || echo "")
            fi
            # Write to a temp file that the launcher can read
            echo "$TLAUNCHER_PREVIOUS_WINDOW" > "/tmp/tlauncher-previous-window-$$"
        } &
        
        # Export the temp file path so launcher knows where to look
        export TLAUNCHER_PREVIOUS_WINDOW_FILE="/tmp/tlauncher-previous-window-$$"
    fi
    
    # Build arguments for recursive call (without -t flag)
    args=()
    for prefix in "${MODES_ORDER[@]}"; do
        mode_info="${MODES_INFO[$prefix]}"
        cmdline_switch=$(echo "$mode_info" | awk '{print $3}')
        if [[ "$START_MODE" == "$prefix" ]]; then
            args+=("$cmdline_switch")
            break
        fi
    done
    
    # Launch alacritty with the launcher
    alacritty \
        --class=launcher \
        --title="Application Launcher" \
        --option 'window.decorations="none"' \
        -e "$0" "${args[@]}" &
    
    # Focus the launcher window after a brief delay
    if has_hyprctl; then
        sleep 0.1
        hyprctl dispatch focuswindow class:launcher
    fi
    
    # Wait for the background process
    wait
    
    exit 0
fi

# Check for existing launcher instance for non-terminal mode
if [[ "$TERMINAL_MODE" != true ]]; then
    if check_existing_launcher; then
        exit 0
    fi
fi

# Main execution
if [[ ! -f "$CACHE_FILE" ]]; then
    # No cache exists, build it now
    rebuild_cache
elif cache_is_stale && [[ ! -f "$LOCK_FILE" ]]; then
    # Cache is stale and no rebuild in progress, start background rebuild
    (
        touch "$LOCK_FILE"
        rebuild_cache
        rm -f "$LOCK_FILE"
    ) &
fi

# Get the path to this script for reload calls
SCRIPT_PATH="$0"

# FZF styling configuration
FZF_HEIGHT="100%"
FZF_LAYOUT="reverse"
FZF_MARGIN="1,2"
FZF_COLORS="prompt:#7aa2f7,pointer:#bb9af7,marker:#7dcfff"
FZF_DELIMITER=$'\t'
FZF_WITH_NTH="1"
FZF_NTH="1,2"

# FZF transform logic helpers
# Dynamic query transform functions that work with any mode
get_prompt_for_query() {
    local conditions="if [[ -z {q} ]]; then echo -n '🚀 ';"
    
    for prefix in "${MODES_ORDER[@]}"; do
        local mode_info="${MODES_INFO[$prefix]}"
        local icon=$(echo "$mode_info" | awk '{print $1}')
        local escaped_prefix=$(printf '%q' "$prefix")
        conditions="$conditions elif [[ {q} == $escaped_prefix* ]]; then echo -n '$icon ';"
    done
    
    conditions="$conditions else echo -n '🚀 '; fi"
    echo "$conditions"
}

get_query_transform() {
    local conditions=""
    
    # Build transform conditions for hierarchical mode switching
    for prefix in "${MODES_ORDER[@]}"; do
        local escaped_prefix=$(printf '%q' "$prefix")
        
        # Handle spaced variants for child modes (e.g., ": power" -> ":power ")
        if [[ "$prefix" =~ ^: ]] && [[ "$prefix" != ":" ]]; then
            local spaced_variant=": ${prefix#:}"
            if [[ -n "$conditions" ]]; then
                conditions="$conditions elif [[ {q} == '$spaced_variant' ]]; then echo -n '$prefix ';"
            else
                conditions="if [[ {q} == '$spaced_variant' ]]; then echo -n '$prefix ';"
            fi
        fi
        
        # Handle exact matches - ALL modes get a space when activated
        local output_value="$prefix "
        # All navigable modes get a space for consistent UX
        
        if [[ -n "$conditions" ]]; then
            conditions="$conditions elif [[ {q} == '$prefix' ]]; then echo -n '$output_value';"
        else
            conditions="if [[ {q} == '$prefix' ]]; then echo -n '$output_value';"
        fi
    done
    
    # Special handling for the / / -> // transformation
    if [[ -n "$conditions" ]]; then
        conditions="$conditions elif [[ {q} == '/ /' ]]; then echo -n '// ';"
    else
        conditions="if [[ {q} == '/ /' ]]; then echo -n '// ';"
    fi
    
    # Add fallback
    if [[ -n "$conditions" ]]; then
        conditions="$conditions else echo -n '{q}'; fi"
    else
        conditions="echo -n '{q}'"
    fi
    
    echo "$conditions"
}

get_backspace_query_transform() {
    local conditions=""
    
    # Handle hierarchical backspace navigation
    for prefix in "${MODES_ORDER[@]}"; do
        if is_child_mode "$prefix"; then
            # Child modes (both spaced and non-spaced): go to parent with space
            local parent_mode=$(get_parent_mode "$prefix")
            
            # Handle spaced version
            if [[ -n "$conditions" ]]; then
                conditions="$conditions elif [[ {q} == '$prefix ' ]]; then echo -n '$parent_mode ';"
            else
                conditions="if [[ {q} == '$prefix ' ]]; then echo -n '$parent_mode ';"
            fi
            
            # Handle non-spaced version (this was the bug!)
            conditions="$conditions elif [[ {q} == '$prefix' ]]; then echo -n '$parent_mode ';"
            
        else
            # Parent/leaf modes: backspace clears completely
            if [[ -n "$conditions" ]]; then
                conditions="$conditions elif [[ {q} == '$prefix ' ]]; then echo -n '';"
                conditions="$conditions elif [[ {q} == '$prefix' ]]; then echo -n '';"
            else
                conditions="if [[ {q} == '$prefix ' ]]; then echo -n '';"
                conditions="$conditions elif [[ {q} == '$prefix' ]]; then echo -n '';"
            fi
        fi
    done
    
    if [[ -n "$conditions" ]]; then
        conditions="$conditions else echo -n '{q}'; fi"
    else
        conditions="echo -n '{q}'"
    fi
    
    echo "$conditions"
}

get_backspace_prompt_transform() {
    local conditions="if [[ {q} == '' ]]; then echo -n '🚀 ';"
    
    for prefix in "${MODES_ORDER[@]}"; do
        local mode_info="${MODES_INFO[$prefix]}"
        local icon=$(echo "$mode_info" | awk '{print $1}')
        local escaped_prefix=$(printf '%q' "$prefix")
        conditions="$conditions elif [[ {q} == $escaped_prefix* ]]; then echo -n '$icon ';"
    done
    
    conditions="$conditions else echo -n '🚀 '; fi"
    echo "$conditions"
}

# Set prompt and initial data based on mode
if [[ -n "$START_MODE" ]]; then
    # Get mode info and set prompt and data dynamically
    mode_info="${MODES_INFO[$START_MODE]}"
    icon=$(echo "$mode_info" | awk '{print $1}')
    PROMPT="$icon "
    INITIAL_DATA=$(load_mode_data "$START_MODE" "$INITIAL_QUERY")
else
    PROMPT="🚀 "
    INITIAL_DATA=$(cat "$CACHE_FILE" 2>/dev/null || echo "")
fi

# Use existing cache for immediate response
if [[ -f "$CACHE_FILE" || -n "$START_MODE" ]]; then
    selected=$(echo "$INITIAL_DATA" | fzf \
        --delimiter="$FZF_DELIMITER" \
        --with-nth="$FZF_WITH_NTH" \
        --nth="$FZF_NTH" \
        --query="$INITIAL_QUERY" \
        --height="$FZF_HEIGHT" \
        --layout="$FZF_LAYOUT" \
        --margin="$FZF_MARGIN" \
        --color="$FZF_COLORS" \
        --info=hidden \
        --ansi \
        --bind="change:reload($SCRIPT_PATH --reload $CACHE_FILE {q})+transform-prompt($(get_prompt_for_query))+transform-query($(get_query_transform))" \
        --bind="start:transform-prompt(echo -n '$PROMPT')" \
        --bind="bspace:backward-delete-char+transform-query($(get_backspace_query_transform))+transform-prompt($(get_backspace_prompt_transform))" \
        --bind="esc:abort" \
        | cut -d"$FZF_DELIMITER" -f3)
else
    # Fallback if no cache (should rarely happen)
    rebuild_cache
    selected=$(cat "$CACHE_FILE" | fzf \
        --delimiter="$FZF_DELIMITER" \
        --with-nth="$FZF_WITH_NTH" \
        --nth="$FZF_NTH" \
        --prompt="🚀 " \
        --query="$INITIAL_QUERY" \
        --height="$FZF_HEIGHT" \
        --layout="$FZF_LAYOUT" \
        --margin="$FZF_MARGIN" \
        --color="$FZF_COLORS" \
        --info=hidden \
        --ansi \
        --bind="change:reload($SCRIPT_PATH --reload $CACHE_FILE {q})+transform-prompt($(get_prompt_for_query))+transform-query($(get_query_transform))" \
        --bind="start:transform-prompt(echo -n '$PROMPT')" \
        --bind="bspace:backward-delete-char+transform-query($(get_backspace_query_transform))+transform-prompt($(get_backspace_prompt_transform))" \
        --bind="esc:abort" \
        | cut -d"$FZF_DELIMITER" -f3)
fi


# Handle the initial selection and enter loop only if needed
while true; do
    # Launch the selected application or execute system action
    if [ -n "$selected" ]; then
        # Try to handle selection through mode-specific handlers first
        handled=false
        should_continue=false
        
        for prefix in "${MODES_ORDER[@]}"; do
            if handle_mode_selection "$prefix" "$selected"; then
                handled=true
                # Check if this was an interactive mode that should continue the loop
                # Only run_cmd_in_terminal and ask_ai should continue, run_cmd_with_shell should not
                if [[ "$selected" =~ ^(run_cmd_in_terminal:|ask_ai:) ]] && [[ -n "$TLAUNCHER_PREVIOUS_WINDOW_FILE" ]]; then
                    should_continue=true
                fi
                break
            fi
        done
        
        # If no mode handled it, fall back to desktop application launch
        if [[ "$handled" == false ]]; then
            # Launch desktop application
            launch_app "gtk-launch $selected"
            # Desktop apps should not continue the loop
            should_continue=false
        fi
        
        # Exit if not in terminal mode, or if this wasn't an interactive command
        if [[ -z "$TLAUNCHER_PREVIOUS_WINDOW_FILE" ]] || [[ "$should_continue" == false ]]; then
            break
        fi
        
        # In terminal mode, restart FZF for continuous use (only if we should continue)
        selected=$(echo "$INITIAL_DATA" | fzf \
            --delimiter="$FZF_DELIMITER" \
            --with-nth="$FZF_WITH_NTH" \
            --nth="$FZF_NTH" \
            --query="" \
            --height="$FZF_HEIGHT" \
            --layout="$FZF_LAYOUT" \
            --margin="$FZF_MARGIN" \
            --color="$FZF_COLORS" \
            --info=hidden \
            --ansi \
            --bind="change:reload($SCRIPT_PATH --reload $CACHE_FILE {q})+transform-prompt($(get_prompt_for_query))+transform-query($(get_query_transform))" \
            --bind="start:transform-prompt(echo -n '$PROMPT')" \
            --bind="bspace:backward-delete-char+transform-query($(get_backspace_query_transform))+transform-prompt($(get_backspace_prompt_transform))" \
            --bind="esc:abort" \
            | cut -d"$FZF_DELIMITER" -f3)
        
        # If user cancelled (ESC or Ctrl+C), exit
        if [[ -z "$selected" ]]; then
            break
        fi
    else
        # No selection, exit
        break
    fi
done

# Cleanup temp file if it exists
if [[ -n "$TLAUNCHER_PREVIOUS_WINDOW_FILE" && -f "$TLAUNCHER_PREVIOUS_WINDOW_FILE" ]]; then
    rm -f "$TLAUNCHER_PREVIOUS_WINDOW_FILE"
fi
