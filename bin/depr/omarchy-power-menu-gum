#!/bin/bash

# Power menu for system-setup using gum filter
# Provides power off, restart, and sleep options

# Function to show power menu using gum filter
show_power_menu() {
  # Use the same menu options as original (with icons)
  local menu_options=(
    " Lock"
    "󰤄 Suspend"
    " Relaunch"
    "󰜉 Restart"
    "󰐥 Shutdown"
  )
  
  local selection=$(printf '%s\n' "${menu_options[@]}" | gum filter \
    --placeholder="Select Power Option... ⚡")

  case "$selection" in
  *Lock*) hyprctl dispatch exec hyprlock ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) hyprctl dispatch exit ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  esac
}

# Main execution
show_power_menu
