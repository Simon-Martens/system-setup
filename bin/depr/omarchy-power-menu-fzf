#!/bin/bash

# Power menu for system-setup using fzf
# Provides power off, restart, and sleep options

# Function to show power menu using fzf
show_power_menu() {
  # Use the same menu options as original (with icons)
  local menu_options="🔒 Lock
󰤄 Suspend
🔄 Relaunch
󰜉 Restart
󰐥 Shutdown"
  
  local selection=$(echo -e "$menu_options" | fzf \
    --prompt="⚡ Power: " \
    --height=100% \
    --layout=reverse \
    --margin=1,2 \
    --color="prompt:#7aa2f7,pointer:#bb9af7,marker:#7dcfff" \
    --info=hidden \
    --ansi)

  case "$selection" in
  *Lock*) hyprlock ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) hyprctl dispatch exit ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  esac
}

# Main execution
show_power_menu