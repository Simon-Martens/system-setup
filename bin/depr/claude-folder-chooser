#!/bin/bash

# Get home directory
HOME_DIR="$HOME"

# Create a temporary file to store the selected folder
TEMP_FILE=$(mktemp)

# Function to get zoxide directories with ~/source/claude at the top
get_zoxide_directories() {
    # First, add ~/source/claude if it exists
    if [ -d "$HOME/source/claude" ]; then
        echo "$HOME/source/claude"
    fi
    
    # Then add zoxide directories, excluding the one we already added
    zoxide query -l 2>/dev/null | grep -v "^$HOME/source/claude$" || true
}

# Function to get all directories with ~/source/claude at the top
get_all_directories() {
    # First, add ~/source/claude if it exists
    if [ -d "$HOME/source/claude" ]; then
        echo "$HOME/source/claude"
    fi
    
    # Then add all other directories from home, excluding the one we already added
    find "$HOME_DIR" -type d -not -path "*/.*" 2>/dev/null | grep -v "^$HOME/source/claude$" | sort
}

# Launch alacritty with fzf for folder selection
alacritty --class AI --title "Folder Chooser" -e bash -c "
    # Define functions inline
    get_zoxide_directories() {
        if [ -d \"$HOME/source/claude\" ]; then
            echo \"$HOME/source/claude\"
        fi
        zoxide query -l 2>/dev/null | grep -v \"^$HOME/source/claude$\" || true
    }
    
    get_all_directories() {
        if [ -d \"$HOME/source/claude\" ]; then
            echo \"$HOME/source/claude\"
        fi
        find \"$HOME\" -type d 2>/dev/null | grep -v \"^$HOME/source/claude$\" | sort
    }
    
    selected_folder=\$(get_zoxide_directories | fzf --prompt='🤖 AI: ' --layout=reverse --tiebreak=length --bind 'ctrl-a:reload(if [ -d \"$HOME/source/claude\" ]; then echo \"$HOME/source/claude\"; fi; find \"$HOME\" -type d 2>/dev/null | grep -v \"^$HOME/source/claude$\" | sort)')
    
    if [ -n \"\$selected_folder\" ]; then
        echo \"\$selected_folder\" > $TEMP_FILE
    fi
"

# Wait a moment for the file to be written
sleep 0.1

# Read the selected folder
if [ -f "$TEMP_FILE" ] && [ -s "$TEMP_FILE" ]; then
    SELECTED_FOLDER=$(cat "$TEMP_FILE")
    rm "$TEMP_FILE"
    
    # Launch new alacritty window in the selected folder with claude
    hyprctl dispatch exec "alacritty --working-directory '$SELECTED_FOLDER' -e claude"
else
    rm -f "$TEMP_FILE"
fi
