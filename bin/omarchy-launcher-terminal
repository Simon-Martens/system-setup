#!/bin/bash

# Opens alacritty with the fzf launcher with nice styling
# Capture the currently active window in background while launching terminal
if command -v hyprctl >/dev/null 2>&1; then
    # Start window capture in background and launch terminal immediately
    {
        OMARCHY_PREVIOUS_WINDOW=$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty')
        # Write to a temp file that the launcher can read
        echo "$OMARCHY_PREVIOUS_WINDOW" > "/tmp/omarchy-previous-window-$$"
    } &
    
    # Export the temp file path so launcher knows where to look
    export OMARCHY_PREVIOUS_WINDOW_FILE="/tmp/omarchy-previous-window-$$"
fi

alacritty \
    --class=launcher \
    --title="Application Launcher" \
    --option 'window.decorations="none"' \
    -e "$HOME/.local/share/omarchy/bin/omarchy-launcher" "$@"
