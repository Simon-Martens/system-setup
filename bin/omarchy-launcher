#!/bin/bash

# Fast FZF-based application launcher with caching
# Builds cache in background, uses existing cache for immediate startup

CACHE_DIR="$HOME/.cache/fzf-launcher"
CACHE_FILE="$CACHE_DIR/apps.cache"
LOCK_FILE="$CACHE_DIR/rebuild.lock"
ACTIONS_SCRIPT="$HOME/.local/share/omarchy/bin/actions.sh"

mkdir -p "$CACHE_DIR"

process_desktop_file() {
    local desktop_file="$1"
    local name generic_name comment hidden nodisplay
    
    # Quick type check
    grep -q "^Type=Application" "$desktop_file" || return
    
    # Check Hidden and NoDisplay fields
    hidden=$(grep "^Hidden=" "$desktop_file" 2>/dev/null | cut -d'=' -f2)
    nodisplay=$(grep "^NoDisplay=" "$desktop_file" 2>/dev/null | cut -d'=' -f2)
    
    [[ "$hidden" == "true" || "$nodisplay" == "true" ]] && return
    
    # Extract name fields
    name=$(grep "^Name=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    generic_name=$(grep "^GenericName=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    comment=$(grep "^Comment=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    keywords=$(grep "^Keywords=" "$desktop_file" | head -1 | cut -d'=' -f2-)
    
    # Build display string: prefer generic name, show short comment if no generic name
    display_name="$name"
    if [[ -n "$generic_name" && "$generic_name" != "$name" ]]; then
        # Use generic name if available
        display_name="$name"$'\033[90m'" · $generic_name"$'\033[0m'
    elif [[ -n "$comment" && ${#comment} -le 30 ]]; then
        # Use short comment (30 chars or less) if no generic name
        display_name="$name"$'\033[90m'" · $comment"$'\033[0m'
    fi
    
    # Build search text (includes keywords but they won't be displayed)
    search_text="$name"
    [[ -n "$generic_name" ]] && search_text="$search_text $generic_name"
    [[ -n "$comment" ]] && search_text="$search_text $comment"
    [[ -n "$keywords" ]] && search_text="$search_text $keywords"
    
    basename=$(basename "$desktop_file" .desktop)
    echo "$display_name"$'\t'"$search_text"$'\t'"$basename"
}

rebuild_cache() {
    # Build search directories
    declare -a search_dirs=()
    [[ -n "$XDG_DATA_HOME" ]] && search_dirs+=("$XDG_DATA_HOME/applications")
    [[ -z "$XDG_DATA_HOME" ]] && search_dirs+=("$HOME/.local/share/applications")

    if [[ -n "$XDG_DATA_DIRS" ]]; then
        IFS=':' read -ra dirs <<< "$XDG_DATA_DIRS"
        for dir in "${dirs[@]}"; do
            search_dirs+=("$dir/applications")
        done
    else
        search_dirs+=("/usr/local/share/applications" "/usr/share/applications")
    fi

    # Process desktop files
    declare -A seen_apps
    for dir in "${search_dirs[@]}"; do
        [[ -d "$dir" ]] || continue
        find "$dir" -maxdepth 1 -name "*.desktop" 2>/dev/null
    done | while read desktop_file; do
        basename=$(basename "$desktop_file" .desktop)
        [[ -n "${seen_apps[$basename]}" ]] && continue
        seen_apps[$basename]=1
        process_desktop_file "$desktop_file"
    done | sort > "$CACHE_FILE.tmp" && mv "$CACHE_FILE.tmp" "$CACHE_FILE"
}

load_power_actions() {
    [[ ! -f "$ACTIONS_SCRIPT" ]] && return
    
    # Get only power-related actions and add :power prefix
    "$ACTIONS_SCRIPT" | grep -E "(Lock|Suspend|Relaunch|Restart|Shutdown)" | while IFS=$'\t' read -r display_name search_text command; do
        echo ":power $display_name"$'\t'":power $search_text"$'\t'"$command"
    done
}

load_governor_actions() {
    # Get available CPU governors and create actions dynamically
    if [[ -f "/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors" ]]; then
        local current_governor=""
        if [[ -f "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor" ]]; then
            current_governor=$(cat "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor" 2>/dev/null)
        fi
        
        while read -r gov; do
            [[ -z "$gov" ]] && continue
            
            local display_name="$gov"
            local command_string=""
            
            if [[ "$gov" == "$current_governor" ]]; then
                display_name="$display_name"$'\033[90m'" · current"$'\033[0m'
                # No-op command for current governor
                command_string="echo 'Governor $gov is already active'"
            else  
                display_name="$display_name"$'\033[90m'" · set CPU governor"$'\033[0m'
                # Use the dedicated governor script
                command_string="hyprctl dispatch exec \"$HOME/.local/share/omarchy/bin/omarchy-set-governor $gov\""
            fi
            
            echo ":governor $display_name"$'\t'":governor $gov set CPU governor"$'\t'"$command_string"
        done < <(cat "/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors" | tr ' ' '\n' | sort)
    fi
}

cache_is_stale() {
    [[ ! -f "$CACHE_FILE" ]] && return 0
    
    # Check if any desktop directory is newer than cache
    declare -a search_dirs=()
    [[ -n "$XDG_DATA_HOME" ]] && search_dirs+=("$XDG_DATA_HOME/applications")
    [[ -z "$XDG_DATA_HOME" ]] && search_dirs+=("$HOME/.local/share/applications")
    
    if [[ -n "$XDG_DATA_DIRS" ]]; then
        IFS=':' read -ra dirs <<< "$XDG_DATA_DIRS"
        for dir in "${dirs[@]}"; do
            search_dirs+=("$dir/applications")
        done
    else
        search_dirs+=("/usr/local/share/applications" "/usr/share/applications")
    fi
    
    for dir in "${search_dirs[@]}"; do
        [[ -d "$dir" && "$dir" -nt "$CACHE_FILE" ]] && return 0
    done
    
    return 1
}

load_system_actions() {
    [[ ! -f "$ACTIONS_SCRIPT" ]] && return
    
    # Use the actions.sh script to get formatted actions
    "$ACTIONS_SCRIPT" | while IFS=$'\t' read -r display_name search_text command; do
        echo ":$display_name"$'\t'":$search_text"$'\t'"$command"
    done
}

load_workspaces() {
    # Check if hyprctl is available
    command -v hyprctl >/dev/null 2>&1 || return
    
    # Get active workspaces with their last window titles
    hyprctl -j workspaces 2>/dev/null | jq -r '
        .[] | 
        select(.windows > 0) |
        "// " + (.id | tostring) + ": " + .lastwindowtitle +
        "\u001b[90m · " + (.windows | tostring) + " windows\u001b[0m" +
        "\t// " + (.id | tostring) + " " + .lastwindowtitle +
        "\tworkspace:" + (.id | tostring)
    ' 2>/dev/null
}

load_windows() {
    # Check if hyprctl is available
    command -v hyprctl >/dev/null 2>&1 || return
    
    # Get all windows with their details
    hyprctl -j clients 2>/dev/null | jq -r '
        .[] | 
        select(.mapped == true) |
        select(.class != "launcher") |
        {
            title: (if .title == "" then .initialTitle else .title end),
            class: .class,
            address: .address,
            workspace: .workspace.name,
            minimized: (.workspace.name == "special:minimized")
        } |
        "/ " + .title + 
        (if .minimized then " (minimized)" else "" end) +
        "\u001b[90m · " + .class + "\u001b[0m" +
        "\t/ " + .title + " " + .class + 
        (if .minimized then " minimized" else "" end) +
        "\tfocus_window:" + .address
    ' 2>/dev/null
}

load_tmux_sessions() {
    # Check if tmux is available
    command -v tmux >/dev/null 2>&1 || return
    
    # Use the same approach as tmux-session-wizard-rewired
    (
        # First: Get existing tmux sessions sorted by recency
        if tmux list-sessions >/dev/null 2>&1; then
            tmux list-sessions -F "#{session_last_attached} #{session_name}: #{session_windows} window(s)#{?session_attached, (attached),}" 2>/dev/null | \
            sort -rn | cut -d' ' -f2- | while read -r session_info; do
                session_name=$(echo "$session_info" | cut -d':' -f1)
                session_desc=$(echo "$session_info" | cut -d':' -f2-)
                echo "$ $session_name"$'\033[90m'" ·$session_desc"$'\033[0m'$'\t'"$ $session_name $session_desc"$'\t'"tmux_session:$session_name"
            done
        fi
        
        # Second: Add zoxide directories for new session creation
        if command -v zoxide >/dev/null 2>&1; then
            zoxide query -l | grep -v '^/$' | grep -v '^/tmp' | grep -v '^/var' | head -60 | while read -r dir; do
                dir_tilde=$(echo "$dir" | sed "s|$HOME|~|g")
                dir_name=$(basename "$dir_tilde")
                echo "$ $dir_name"$'\033[90m'" · Create session in $dir_tilde"$'\033[0m'$'\t'"$ $dir_name $dir_tilde new session"$'\t'"tmux_new:$dir"
            done
        fi
    )
}

load_theme_actions() {
    local themes_dir="$HOME/.config/omarchy/themes/"
    local current_theme_dir="$HOME/.config/omarchy/current/theme"
    
    # Check if themes directory exists
    [[ -d "$themes_dir" ]] || return
    
    # Get current theme name
    local current_theme_name=""
    if [[ -e "$current_theme_dir" ]]; then
        current_theme_name=$(basename "$(realpath "$current_theme_dir" 2>/dev/null)" 2>/dev/null)
    fi
    
    # List available themes (both directories and symlinks)
    find "$themes_dir" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf "%f\n" 2>/dev/null | sort | while read -r theme; do
        [[ -z "$theme" ]] && continue
        
        local display_name="🎨 $theme"
        local command_string=""
        
        if [[ "$theme" == "$current_theme_name" ]]; then
            display_name="$display_name"$'\x1b[90m'" · current"$'\x1b[0m'
            # No-op command for current theme
            command_string="echo 'Theme $theme is already active'"
        else
            display_name="$display_name"$'\x1b[90m'" · switch theme"$'\x1b[0m'
            # Use the theme set script
            command_string="hyprctl dispatch exec \"$HOME/.local/share/omarchy/bin/omarchy-theme-set '$theme'\""
        fi
        
        echo ":theme $display_name"$'\t'":theme $theme switch theme"$'\t'"$command_string"
    done
}

# Parse command line arguments
START_MODE=""
INITIAL_QUERY=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --update)
            echo "Updating cache..."
            rebuild_cache
            echo "Cache updated successfully"
            exit 0
            ;;
        --windows)
            START_MODE="windows"
            INITIAL_QUERY="/ "
            shift
            ;;
        --workspaces)
            START_MODE="workspaces"
            INITIAL_QUERY="// "
            shift
            ;;
        --actions)
            START_MODE="actions"
            INITIAL_QUERY=":"
            shift
            ;;
        --tmux)
            START_MODE="tmux"
            INITIAL_QUERY="$ "
            shift
            ;;
        --power)
            START_MODE="power"
            INITIAL_QUERY=":power "
            shift
            ;;
        --governor)
            START_MODE="governor"
            INITIAL_QUERY=":governor "
            shift
            ;;
        --themes)
            START_MODE="themes"
            INITIAL_QUERY=":theme "
            shift
            ;;
        *)
            echo "Usage: $0 [--update] [--windows] [--workspaces] [--actions] [--tmux] [--power] [--governor] [--themes]"
            echo "  --update     Update application cache"
            echo "  --windows    Start in window switching mode"
            echo "  --workspaces Start in workspace switching mode"
            echo "  --actions    Start in system actions mode"
            echo "  --tmux       Start in tmux session mode"
            echo "  --power      Start in power menu mode"
            echo "  --governor   Start in CPU governor menu mode"
            echo "  --themes     Start in theme selection mode"
            exit 1
            ;;
    esac
done

# Main execution
if [[ ! -f "$CACHE_FILE" ]]; then
    # No cache exists, build it now
    rebuild_cache
elif cache_is_stale && [[ ! -f "$LOCK_FILE" ]]; then
    # Cache is stale and no rebuild in progress, start background rebuild
    (
        touch "$LOCK_FILE"
        rebuild_cache
        rm -f "$LOCK_FILE"
    ) &
fi

# Create a script for dynamic reloading
reload_script=$(mktemp)
cat > "$reload_script" << 'EOF'
#!/bin/bash
CACHE_FILE="$1"
ACTIONS_SCRIPT="$2"

load_system_actions() {
    [[ ! -f "$ACTIONS_SCRIPT" ]] && return
    
    # Use the actions.sh script to get formatted actions
    "$ACTIONS_SCRIPT" | while IFS=$'\t' read -r display_name search_text command; do
        echo ":$display_name"$'\t'":$search_text"$'\t'"$command"
    done
}

load_workspaces() {
    # Check if hyprctl is available
    command -v hyprctl >/dev/null 2>&1 || return
    
    # Get active workspaces with their last window titles
    hyprctl -j workspaces 2>/dev/null | jq -r '
        .[] | 
        select(.windows > 0) |
        "// " + (.id | tostring) + ": " + .lastwindowtitle +
        "\u001b[90m · " + (.windows | tostring) + " windows\u001b[0m" +
        "\t// " + (.id | tostring) + " " + .lastwindowtitle +
        "\tworkspace:" + (.id | tostring)
    ' 2>/dev/null
}

load_windows() {
    # Check if hyprctl is available
    command -v hyprctl >/dev/null 2>&1 || return
    
    # Get all windows with their details
    hyprctl -j clients 2>/dev/null | jq -r '
        .[] | 
        select(.mapped == true) |
        select(.class != "launcher") |
        {
            title: (if .title == "" then .initialTitle else .title end),
            class: .class,
            address: .address,
            workspace: .workspace.name,
            minimized: (.workspace.name == "special:minimized")
        } |
        "/ " + .title + 
        (if .minimized then " (minimized)" else "" end) +
        "\u001b[90m · " + .class + "\u001b[0m" +
        "\t/ " + .title + " " + .class + 
        (if .minimized then " minimized" else "" end) +
        "\tfocus_window:" + .address
    ' 2>/dev/null
}

load_tmux_sessions() {
    # Check if tmux is available
    command -v tmux >/dev/null 2>&1 || return
    
    # Use the same approach as tmux-session-wizard-rewired
    (
        # First: Get existing tmux sessions sorted by recency
        if tmux list-sessions >/dev/null 2>&1; then
            tmux list-sessions -F "#{session_last_attached} #{session_name}: #{session_windows} window(s)#{?session_attached, (attached),}" 2>/dev/null | \
            sort -rn | cut -d' ' -f2- | while read -r session_info; do
                session_name=$(echo "$session_info" | cut -d':' -f1)
                session_desc=$(echo "$session_info" | cut -d':' -f2-)
                echo "$ $session_name"$'\033[90m'" ·$session_desc"$'\033[0m'$'\t'"$ $session_name $session_desc"$'\t'"tmux_session:$session_name"
            done
        fi
        
        # Second: Add zoxide directories for new session creation
        if command -v zoxide >/dev/null 2>&1; then
            zoxide query -l | grep -v '^/$' | grep -v '^/tmp' | grep -v '^/var' | head -60 | while read -r dir; do
                dir_tilde=$(echo "$dir" | sed "s|$HOME|~|g")
                dir_name=$(basename "$dir_tilde")
                echo "$ $dir_name"$'\033[90m'" · Create session in $dir_tilde"$'\033[0m'$'\t'"$ $dir_name $dir_tilde new session"$'\t'"tmux_new:$dir"
            done
        fi
    )
}

load_power_actions() {
    [[ ! -f "$ACTIONS_SCRIPT" ]] && return
    
    # Get only power-related actions and add :power prefix
    "$ACTIONS_SCRIPT" | grep -E "(Lock|Suspend|Relaunch|Restart|Shutdown)" | while IFS=$'\t' read -r display_name search_text command; do
        echo ":power $display_name"$'\t'":power $search_text"$'\t'"$command"
    done
}

load_governor_actions() {
    # Get available CPU governors and create actions dynamically
    if [[ -f "/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors" ]]; then
        local current_governor=""
        if [[ -f "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor" ]]; then
            current_governor=$(cat "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor" 2>/dev/null)
        fi
        
        while read -r gov; do
            [[ -z "$gov" ]] && continue
            
            local display_name="$gov"
            local command_string=""
            
            if [[ "$gov" == "$current_governor" ]]; then
                display_name="$display_name"$'\033[90m'" · current"$'\033[0m'
                # No-op command for current governor
                command_string="echo 'Governor $gov is already active'"
            else  
                display_name="$display_name"$'\033[90m'" · set CPU governor"$'\033[0m'
                # Use the dedicated governor script
                command_string="hyprctl dispatch exec \"$HOME/.local/share/omarchy/bin/omarchy-set-governor $gov\""
            fi
            
            echo ":governor $display_name"$'\t'":governor $gov set CPU governor"$'\t'"$command_string"
        done < <(cat "/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors" | tr ' ' '\n' | sort)
    fi
}

load_theme_actions() {
    local themes_dir="$HOME/.config/omarchy/themes/"
    local current_theme_dir="$HOME/.config/omarchy/current/theme"
    
    # Check if themes directory exists
    [[ -d "$themes_dir" ]] || return
    
    # Get current theme name
    local current_theme_name=""
    if [[ -e "$current_theme_dir" ]]; then
        current_theme_name=$(basename "$(realpath "$current_theme_dir" 2>/dev/null)" 2>/dev/null)
    fi
    
    # List available themes (both directories and symlinks)
    find "$themes_dir" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf "%f\n" 2>/dev/null | sort | while read -r theme; do
        [[ -z "$theme" ]] && continue
        
        local display_name="🎨 $theme"
        local command_string=""
        
        if [[ "$theme" == "$current_theme_name" ]]; then
            display_name="$display_name"$'\033[90m'" · current"$'\033[0m'
            # No-op command for current theme
            command_string="echo 'Theme $theme is already active'"
        else
            display_name="$display_name"$'\033[90m'" · switch theme"$'\033[0m'
            # Use the theme set script
            command_string="hyprctl dispatch exec \"$HOME/.local/share/omarchy/bin/omarchy-theme-set '$theme'\""
        fi
        
        echo ":theme $display_name"$'\t'":theme $theme switch theme"$'\t'"$command_string"
    done
}

if [[ "$3" == :governor* ]]; then
    load_governor_actions
elif [[ "$3" == :theme* ]]; then
    load_theme_actions
elif [[ "$3" == :power* ]]; then
    load_power_actions
elif [[ "$3" == :* ]]; then
    load_system_actions
elif [[ "$3" == "//"* ]]; then
    load_workspaces
elif [[ "$3" == "$"* ]]; then
    load_tmux_sessions
elif [[ "$3" == /* ]]; then
    load_windows
else
    cat "$CACHE_FILE"
fi
EOF
chmod +x "$reload_script"

# Set prompt and initial data based on mode
if [[ "$START_MODE" == "windows" ]]; then
    PROMPT="🪟 "
    INITIAL_DATA=$(load_windows)
elif [[ "$START_MODE" == "workspaces" ]]; then
    PROMPT="🏢 "
    INITIAL_DATA=$(load_workspaces)
elif [[ "$START_MODE" == "actions" ]]; then
    PROMPT="⚡ "
    INITIAL_DATA=$(load_system_actions)
elif [[ "$START_MODE" == "tmux" ]]; then
    PROMPT="📟 "
    INITIAL_DATA=$(load_tmux_sessions)
elif [[ "$START_MODE" == "power" ]]; then
    PROMPT="🔌 "
    INITIAL_DATA=$(load_power_actions)
elif [[ "$START_MODE" == "governor" ]]; then
    PROMPT="⚙️ "
    INITIAL_DATA=$(load_governor_actions)
elif [[ "$START_MODE" == "themes" ]]; then
    PROMPT="🎨 "
    INITIAL_DATA=$(load_theme_actions)
else
    PROMPT="🚀 "
    INITIAL_DATA=$(cat "$CACHE_FILE" 2>/dev/null || echo "")
fi

# Use existing cache for immediate response
if [[ -f "$CACHE_FILE" || -n "$START_MODE" ]]; then
    selected=$(echo "$INITIAL_DATA" | fzf \
        --delimiter=$'\t' \
        --with-nth=1 \
        --nth=1,2 \
        --query="$INITIAL_QUERY" \
        --height=100% \
        --layout=reverse \
        --margin=1,2 \
        --color="prompt:#7aa2f7,pointer:#bb9af7,marker:#7dcfff" \
        --info=hidden \
        --ansi \
        --bind="change:reload($reload_script $CACHE_FILE $ACTIONS_SCRIPT {q})+transform-prompt(if [[ -z {q} ]]; then echo -n '🚀 '; elif [[ {q} == :governor* ]]; then echo -n '⚙️ '; elif [[ {q} == :theme* ]]; then echo -n '🎨 '; elif [[ {q} == :power* ]]; then echo -n '🔌 '; elif [[ {q} == :* ]]; then echo -n '⚡ '; elif [[ {q} == //* ]]; then echo -n '🏢 '; elif [[ {q} == /* ]]; then echo -n '🪟 '; elif [[ {q} == \$* ]]; then echo -n '📟 '; else echo -n '🚀 '; fi)+transform-query(if [[ {q} == ':power' ]]; then echo -n ':power '; elif [[ {q} == ':theme' ]]; then echo -n ':theme '; elif [[ {q} == ':governor' ]]; then echo -n ':governor '; elif [[ {q} == '//' ]]; then echo -n '// '; elif [[ {q} == '/' ]]; then echo -n '/ '; elif [[ {q} == '$' ]]; then echo -n '$ '; else echo -n '{q}'; fi)" \
        --bind="start:transform-prompt(echo -n '$PROMPT')" \
        --bind="bspace:backward-delete-char+transform-query(if [[ {q} == ':power' || {q} == ':theme' || {q} == ':governor' || {q} == '//' || {q} == '/' || {q} == '$' ]]; then echo -n ''; else echo -n '{q}'; fi)+transform-prompt(if [[ {q} == '' ]]; then echo -n '🚀 '; elif [[ {q} == :governor* ]]; then echo -n '⚙️ '; elif [[ {q} == :theme* ]]; then echo -n '🎨 '; elif [[ {q} == :power* ]]; then echo -n '🔌 '; elif [[ {q} == :* ]]; then echo -n '⚡ '; elif [[ {q} == //* ]]; then echo -n '🏢 '; elif [[ {q} == \$* ]]; then echo -n '📟 '; elif [[ {q} == /* ]]; then echo -n '🪟 '; else echo -n '🚀 '; fi)" \
        | cut -d$'\t' -f3)
else
    # Fallback if no cache (should rarely happen)
    rebuild_cache
    selected=$(cat "$CACHE_FILE" | fzf \
        --delimiter=$'\t' \
        --with-nth=1 \
        --nth=1,2 \
        --prompt="🚀 " \
        --query="$INITIAL_QUERY" \
        --height=100% \
        --layout=reverse \
        --margin=1,2 \
        --color="prompt:#7aa2f7,pointer:#bb9af7,marker:#7dcfff" \
        --info=hidden \
        --ansi \
        --bind="change:reload($reload_script $CACHE_FILE $ACTIONS_SCRIPT {q})+transform-prompt(if [[ -z {q} ]]; then echo -n '🚀 '; elif [[ {q} == :governor* ]]; then echo -n '⚙️ '; elif [[ {q} == :theme* ]]; then echo -n '🎨 '; elif [[ {q} == :power* ]]; then echo -n '🔌 '; elif [[ {q} == :* ]]; then echo -n '⚡ '; elif [[ {q} == //* ]]; then echo -n '🏢 '; elif [[ {q} == /* ]]; then echo -n '🪟 '; elif [[ {q} == \$* ]]; then echo -n '📟 '; else echo -n '🚀 '; fi)+transform-query(if [[ {q} == ':power' ]]; then echo -n ':power '; elif [[ {q} == ':theme' ]]; then echo -n ':theme '; elif [[ {q} == ':governor' ]]; then echo -n ':governor '; elif [[ {q} == '//' ]]; then echo -n '// '; elif [[ {q} == '/' ]]; then echo -n '/ '; elif [[ {q} == '$' ]]; then echo -n '$ '; else echo -n '{q}'; fi)" \
        --bind="start:transform-prompt(echo -n '$PROMPT')" \
        --bind="bspace:backward-delete-char+transform-query(if [[ {q} == ':power' || {q} == ':theme' || {q} == ':governor' || {q} == '//' || {q} == '/' || {q} == '$' ]]; then echo -n ''; else echo -n '{q}'; fi)+transform-prompt(if [[ {q} == '' ]]; then echo -n '🚀 '; elif [[ {q} == :governor* ]]; then echo -n '⚙️ '; elif [[ {q} == :theme* ]]; then echo -n '🎨 '; elif [[ {q} == :power* ]]; then echo -n '🔌 '; elif [[ {q} == :* ]]; then echo -n '⚡ '; elif [[ {q} == //* ]]; then echo -n '🏢 '; elif [[ {q} == \$* ]]; then echo -n '📟 '; elif [[ {q} == /* ]]; then echo -n '🪟 '; else echo -n '🚀 '; fi)" \
        | cut -d$'\t' -f3)
fi

# Clean up temp script
rm -f "$reload_script"

# Launch the selected application or execute system action
if [ -n "$selected" ]; then
    # Check if it's a workspace switch command
    if [[ "$selected" =~ ^workspace: ]]; then
        # Extract workspace number and switch to it
        workspace_id="${selected#workspace:}"
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl dispatch workspace "$workspace_id"
        fi
    # Check if it's a window focus command
    elif [[ "$selected" =~ ^focus_window: ]]; then
        # Extract window address and focus it
        window_address="${selected#focus_window:}"
        if command -v hyprctl >/dev/null 2>&1; then
            # Check if window is minimized (in special:minimized workspace)
            window_workspace=$(hyprctl -j clients | jq -r ".[] | select(.address == \"$window_address\") | .workspace.name")
            if [[ "$window_workspace" == "special:minimized" ]]; then
                # Window is minimized - restore it to current workspace
                current_workspace=$(hyprctl -j activeworkspace | jq -r '.name')
                hyprctl dispatch movetoworkspace "$current_workspace,address:$window_address"
            fi
            hyprctl dispatch focuswindow "address:$window_address"
        fi
    # Check if it's a tmux session command
    elif [[ "$selected" =~ ^tmux_session: ]]; then
        # Extract session name and attach to it
        session_name="${selected#tmux_session:}"
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl dispatch exec "alacritty -e tmux attach -t '$session_name'"
        else
            alacritty -e tmux attach -t "$session_name" >/dev/null 2>&1 &
        fi
    # Check if it's a tmux new session command  
    elif [[ "$selected" =~ ^tmux_new: ]]; then
        # Extract directory path and create new session
        dir_path="${selected#tmux_new:}"
        session_name=$(basename "$dir_path" | tr '.[:upper:]' '_[:lower:]')
        if command -v hyprctl >/dev/null 2>&1; then
            if ! tmux has-session -t="$session_name" 2>/dev/null; then
                hyprctl dispatch exec "alacritty -e tmux new-session -s '$session_name' -c '$dir_path'"
            else
                hyprctl dispatch exec "alacritty -e tmux attach -t '$session_name'"
            fi
        else
            if ! tmux has-session -t="$session_name" 2>/dev/null; then
                alacritty -e tmux new-session -s "$session_name" -c "$dir_path" >/dev/null 2>&1 &
            else
                alacritty -e tmux attach -t "$session_name" >/dev/null 2>&1 &
            fi
        fi
    # Check if it's a direct command (hyprctl, systemctl, etc.)
    elif [[ "$selected" =~ ^(loginctl|systemctl|hyprctl|omarchy-|/home/[^/]+/.local/share/omarchy/bin/) ]]; then
        # Execute system action directly
        eval "$selected"
    # Check if it's a system action (function name from actions.sh)
    elif [[ -f "$HOME/.local/share/omarchy/bin/actions.sh" ]]; then
        # Source actions.sh first, then check if function exists
        source "$HOME/.local/share/omarchy/bin/actions.sh"
        if declare -f "$selected" >/dev/null 2>&1; then
            "$selected"
        fi
    else
        # Launch desktop application
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl dispatch -- exec "gtk-launch $selected"
        else
            # Fallback for non-Hyprland environments
            setsid gtk-launch "$selected" >/dev/null 2>&1 &
        fi
    fi
fi
