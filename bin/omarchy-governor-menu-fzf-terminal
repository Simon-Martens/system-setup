#!/bin/bash

# Terminal wrapper for governor menu
alacritty \
  --class=menu \
  --title="CPU Governor" \
  --option window.dimensions.columns=40 \
  --option window.dimensions.lines=12 \
  --option 'window.decorations="none"' \
  --option window.opacity=0.95 \
  -e "$HOME/.local/share/omarchy/bin/omarchy-governor-menu-fzf"
