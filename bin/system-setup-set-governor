#!/usr/bin/env bash

# Simple script to set CPU governor
# Usage: system-setup-set-governor <governor_name>

governor="$1"

if [[ -z "$governor" ]]; then
    echo "Usage: $0 <governor_name>"
    exit 1
fi

# Find all CPU directories
cpu_dirs=($(find "/sys/devices/system/cpu" -maxdepth 1 -type d -name "cpu[0-9]*"))

if [[ -z "$cpu_dirs" ]]; then
    echo "Error: No CPU directories found"
    exit 1
fi

# Build command string
command_string=""
for cpu_dir in "${cpu_dirs[@]}"; do
    governor_file="${cpu_dir}/cpufreq/scaling_governor"
    if [[ -f "$governor_file" ]]; then
        command_string+="echo \"$governor\" > \"$governor_file\"; "
    fi
done

if [[ -z "$command_string" ]]; then
    echo "Error: No scaling_governor files found"
    exit 1
fi

# Execute with pkexec
pkexec bash -c "$command_string"
exit_code=$?

if [[ $exit_code -eq 0 ]]; then
    notify-send "CPU Governor" "Set to: $governor"
else
    notify-send "CPU Governor" "Failed to set governor"
fi

exit $exit_code
