#!/bin/bash

# Set location script - switches location-specific configurations
# Usage: set-location <location>
# Valid locations: work, home, laptop

HYPR_CONFIG="$HOME/.config/hypr/hyprland.conf"
VALID_LOCATIONS=("work" "home" "laptop")

usage() {
    echo "Usage: $0 <location>"
    echo "Valid locations: ${VALID_LOCATIONS[*]}"
    echo ""
    echo "This script updates the Hyprland configuration to source the"
    echo "appropriate location-specific config file."
    exit 1
}

# Check if location is provided
if [[ $# -ne 1 ]]; then
    echo "Error: Location not specified" >&2
    usage
fi

LOCATION="$1"

# Validate location
if [[ ! " ${VALID_LOCATIONS[*]} " =~ " $LOCATION " ]]; then
    echo "Error: Invalid location '$LOCATION'" >&2
    echo "Valid locations: ${VALID_LOCATIONS[*]}" >&2
    exit 1
fi

# Check if hyprland config exists
if [[ ! -f "$HYPR_CONFIG" ]]; then
    echo "Error: Hyprland config not found at $HYPR_CONFIG" >&2
    exit 1
fi

# Check if the location config file exists
LOCATION_CONFIG="$HOME/.config/hypr/$LOCATION.conf"
if [[ ! -f "$LOCATION_CONFIG" ]]; then
    echo "Error: Location config not found at $LOCATION_CONFIG" >&2
    exit 1
fi

# Create backup
BACKUP_FILE="$HYPR_CONFIG.backup.$(date +%Y%m%d_%H%M%S)"
cp "$HYPR_CONFIG" "$BACKUP_FILE"
echo "Created backup: $BACKUP_FILE"

# Get current location from config
CURRENT_LOCATION=""
if grep -q "source = ~/.config/hypr/work.conf" "$HYPR_CONFIG"; then
    CURRENT_LOCATION="work"
elif grep -q "source = ~/.config/hypr/home.conf" "$HYPR_CONFIG"; then
    CURRENT_LOCATION="home" 
elif grep -q "source = ~/.config/hypr/laptop.conf" "$HYPR_CONFIG"; then
    CURRENT_LOCATION="laptop"
else
    echo "Warning: Could not detect current location from config"
fi

# If already at the target location, do nothing
if [[ "$CURRENT_LOCATION" == "$LOCATION" ]]; then
    echo "Already at location: $LOCATION"
    rm "$BACKUP_FILE"  # Remove unnecessary backup
    exit 0
fi

# Update the config file
# Replace any existing location config line with the new one
if [[ -n "$CURRENT_LOCATION" ]]; then
    # Replace existing location line
    sed -i "s|source = ~/.config/hypr/$CURRENT_LOCATION.conf|source = ~/.config/hypr/$LOCATION.conf|g" "$HYPR_CONFIG"
    echo "Switched from $CURRENT_LOCATION to $LOCATION"
else
    # Add new location line after the theme line
    sed -i '/source = ~/.config\/system-setup\/current\/theme\/hyprland.conf/a source = ~/.config/hypr/'"$LOCATION"'.conf' "$HYPR_CONFIG"
    echo "Set location to $LOCATION"
fi

# Verify the change was made
if grep -q "source = ~/.config/hypr/$LOCATION.conf" "$HYPR_CONFIG"; then
    echo "✅ Successfully updated Hyprland config"
    echo "📍 Current location: $LOCATION"
    
    # Notify user about restarting Hyprland
    echo ""
    echo "Note: You may need to restart Hyprland or reload the config for changes to take effect."
    echo "You can restart Hyprland with: hyprctl dispatch exit"
    
    # Send notification if available
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Location Changed" "Switched to: $LOCATION" -i preferences-system
    fi
else
    echo "❌ Error: Failed to update config file" >&2
    echo "Restoring backup..."
    mv "$BACKUP_FILE" "$HYPR_CONFIG"
    exit 1
fi