#!/bin/bash

# Script to show a menu of minimized windows and restore the selected one using fzf.
# It uses hyprctl to find windows on the 'special:minimized' workspace
# and fzf to display the selection menu.

# --- Dependency Check ---

# This script requires 'jq' to parse JSON from hyprctl.
if ! command -v jq &> /dev/null; then
    echo "Error: 'jq' is not installed. Please install it to use this script." >&2
    exit 1
fi

# --- Helper Functions ---

# Function to get all windows currently on the special:minimized workspace.
# It returns a simple list of strings, with each string containing both the
# display name and the window address for robust parsing later.
get_minimized_windows_list() {
    local clients_json
    clients_json=$(hyprctl -j clients)

    # Use jq to parse the json, filter for minimized windows, and output
    # a formatted string: "Title (Class) [Address]"
    # This format makes it easy to extract the address later.
    echo "$clients_json" | jq -r '
        .[] | 
        select(.workspace.name == "special:minimized") | 
        "\(.title) (\(.class)) [\(.address)]"
    '
}

# Function to restore a selected window to the currently active workspace.
# It takes the window's address as an argument.
restore_window() {
    local window_address="$1"

    # Defensive check to ensure we have a valid address.
    if [[ -z "$window_address" ]]; then
        echo "Error: Cannot restore window with empty address." >&2
        exit 1
    fi

    # Get the ID of the currently active workspace.
    local active_workspace_id
    active_workspace_id=$(hyprctl -j activeworkspace | jq -r '.id')

    if [[ -z "$active_workspace_id" ]]; then
        echo "Error: Could not determine active workspace." >&2
        exit 1
    fi
    
    # Dispatch two commands:
    # 1. Move the selected window to the active workspace.
    # 2. Focus the window after moving it.
    hyprctl dispatch movetoworkspace "$active_workspace_id,address:$window_address"
    hyprctl dispatch focuswindow "address:$window_address"
}

# --- Main Menu Function ---

# Displays the window selection menu using fzf.
show_restore_menu() {
    # Get the list of minimized windows.
    local menu_input
    menu_input=$(get_minimized_windows_list)

    # Check if the list is empty.
    if [[ -z "$menu_input" ]]; then
        echo "No windows are currently minimized."
        exit 0
    fi

    # Show the fzf menu with styling options.
    local selection
    selection=$(echo -e "$menu_input" | fzf \
        --prompt="🪟 Restore: " \
        --height=100% \
        --layout=reverse \
        --margin=1,2 \
        --color="prompt:#7aa2f7,pointer:#bb9af7,marker:#7dcfff" \
        --info=hidden \
        --ansi)

    # If the user pressed ESC or didn't make a selection, exit gracefully.
    if [[ -z "$selection" ]]; then
        exit 0
    fi

    # Extract the address directly from the selected string.
    # This uses grep with a regular expression to find the [0x...] part
    # and then `tr` to remove the brackets.
    local selected_address
    selected_address=$(echo "$selection" | grep -o '\[0x[a-fA-F0-9]\+\]' | tr -d '[]')

    # If a valid address was found, restore the window.
    if [[ -n "$selected_address" ]]; then
        restore_window "$selected_address"
    else
        echo "Error: Could not parse address from '$selection'." >&2
        exit 1
    fi
}

# --- Main Execution ---
show_restore_menu