#!/bin/bash

# If not already running in alacritty with launcher class, launch it
if [ "$ALACRITTY_WINDOW_ID" = "" ] || [ "$1" != "--internal" ]; then
    exec alacritty --class launcher -e "$0" --internal
fi

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Simple function to get tmux option or return default
get_tmux_option() {
    local option=$1
    local default_value=$2
    local option_value=$(tmux show-option -gqv "$option" 2>/dev/null)
    if [ -z "$option_value" ]; then
        echo "$default_value"
    else
        echo "$option_value"
    fi
}

# Normalization function
_normalize() {
    tr '.[:upper:]' '_[:lower:]'
}

# Define HOME_REPLACER and TILDE_REPLACER
HOME_REPLACER="s|$HOME|~|g"
TILDE_REPLACER="s|^~|$HOME|"

# Get existing sessions
SELECT_WINDOW=$(get_tmux_option "@session-wizard-windows" "off")
if [ "$SELECT_WINDOW" == "on" ]; then
  RESULT=$(tmux list-windows -a -F "#{session_last_attached} #{session_name}: #{window_name}(#{window_index})\
#{?session_grouped, (group ,}#{session_group}#{?session_grouped,),}#{?session_attached,#{?window_active, (attached),},}")
else
  RESULT=$(tmux list-sessions -F "#{session_last_attached} #{session_name}: #{session_windows} window(s)\
#{?session_grouped, (group ,}#{session_group}#{?session_grouped,),}#{?session_attached, (attached),}")
fi

QUERY_AND_RESULT=$( (
  echo "$RESULT" |
    sort -r | cut -d' ' -f2-
  zoxide query -l | sed -e "$HOME_REPLACER"
) | fzf --reverse --print-query --tiebreak=index --prompt="Session> " --margin=0,0 --info=inline)

FZF_EXIT=$?
if [ $FZF_EXIT -eq 130 ]; then
  exit 0
fi

QUERY=$(echo "$QUERY_AND_RESULT" | head -n 1)
RESULT=$(echo "$QUERY_AND_RESULT" | tail -n 1)

# Nothing was given, name is also empty
if [ -z "$RESULT" ]; then
  exit 0

# Nothing found, but a query given, OR 
# :Query - create new session with that name
elif [ "$RESULT" == "$QUERY" ] || [[ "$QUERY" == :* ]]; then
  if [[ "$QUERY" == :* ]]; then
    QUERY=${QUERY:1}
  fi

  NEW_SESSION_NAME=$(echo "$QUERY" | _normalize)
  
  # Use hyprctl to launch new alacritty with tmux session
  if ! tmux has-session -t="$NEW_SESSION_NAME" 2>/dev/null; then
    hyprctl dispatch exec "alacritty -e tmux new-session -s '$NEW_SESSION_NAME'"
  else
    hyprctl dispatch exec "alacritty -e tmux attach -t '$NEW_SESSION_NAME'"
  fi
  
# Session selected
elif [[ $RESULT == *":"* ]]; then
  SESSION=$(echo "$RESULT" | awk '{print $1}')
  SESSION=${SESSION//:/}
  
  # Escape tilde which if it appears by itself, tmux will interpret as a marked target
  SESSION=$(echo "$SESSION" | sed 's/^~$/\\~/')
  
  if [ "$SELECT_WINDOW" == "on" ]; then
    WINDOW=$(echo "$RESULT" | awk -F"[()]" '{print $(NF-1)}')
    hyprctl dispatch exec "alacritty -e tmux attach -t '$SESSION' \\; select-window -t '$SESSION:$WINDOW'"
  else
    hyprctl dispatch exec "alacritty -e tmux attach -t '$SESSION'"
  fi

# Path selected
else
  DIR_FULL=$(echo "$RESULT" | sed -e "$TILDE_REPLACER")
  DIR_WITH_TILDE=$(echo "$RESULT" | sed -e "$HOME_REPLACER")

  # Quit if directory does not exists
  if [ ! -d "$DIR_FULL" ]; then
    exit 0
  fi

  # Promote rank in zoxide.
  zoxide add "$DIR_FULL"

  SESSION=$(basename "$DIR_WITH_TILDE" | _normalize)

  # Use hyprctl to launch new alacritty with tmux session
  if ! tmux has-session -t="$SESSION" 2>/dev/null; then
    hyprctl dispatch exec "alacritty -e tmux new-session -s '$SESSION' -c '$DIR_FULL'"
  else
    hyprctl dispatch exec "alacritty -e tmux attach -t '$SESSION'"
  fi
fi
