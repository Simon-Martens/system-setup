#!/bin/bash

# system-setup-theme-set: Set a theme, specified by its name.
# Usage: system-setup-theme-set <theme-name>

THEMES_DIR="$HOME/.config/system-setup/themes/"
CURRENT_THEME_DIR="$HOME/.config/system-setup/current/theme"

if [[ -z "$1" ]]; then
  echo "Usage: system-setup-theme-set <theme-name>" >&2
  exit 1
fi

THEME_NAME="$1"
THEME_PATH="$THEMES_DIR/$THEME_NAME"
if [[ -d "$HOME/.config/system-setup/themes/$THEME_NAME/backgrounds" ]]; then
  BACKGROUND_PATH="$HOME/.config/system-setup/themes/$THEME_NAME/backgrounds"
else
  BACKGROUND_PATH="$HOME/.config/system-setup/backgrounds/$THEME_NAME"
fi

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR" >&2
  exit 2
fi

# Update theme symlinks
ln -nsf "$BACKGROUND_PATH" "$HOME/.config/system-setup/current/backgrounds"
ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"
ln -nsf "$HOME/.config/system-setup/current/theme/neovim.lua" "$HOME/.config/nvim/lua/theme.lua"

# Trigger alacritty config reload
touch "$HOME/.config/alacritty/alacritty.toml"

# Restart components to apply new theme
hyprctl reload
makoctl reload
pkill waybar &>/dev/null
setsid waybar &>/dev/null &

# Set new background
first_bg=$(find "$HOME/.config/system-setup/current/backgrounds/" -type f | head -n 1)
if [[ -n "$first_bg" ]]; then
  ln -nsf "$first_bg" "$HOME/.config/system-setup/current/background"
  pkill -x swaybg
  setsid swaybg -i "$HOME/.config/system-setup/current/background" -m fill &
else
  # Background does not exist for this theme - fallback to solid black.
  rm -f "$HOME/.config/system-setup/current/background"
  pkill -x swaybg
  setsid swaybg -c '#000000' &
fi
